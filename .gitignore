# Dependencies
node_modules/

# Build output
dist/

# Vite cache
.vite/

# Environment files
.env
.env.local
.env.*.local

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local Netlify folder
.netlify

# ---------------------------------------------------------------------------
# iOS attendance app (ios/) — the Xcode project is GENERATED by XcodeGen from
# ios/project.yml (`cd ios && xcodegen generate`), so it is never committed.
# ---------------------------------------------------------------------------
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate
.swiftpm/
# Generated from the `info:` block in ios/project.yml at generate time.
ios/FCTCAttendance/Info.plist
ios/FCTCAttendanceShare/Info.plist

# Apps Script (apps-script/) — .clasp.json names a real script id; the tracked
# template is .clasp.json.example.
.clasp.json
.clasprc.json

# Vercel
.vercel

# Local review screenshots (generated ad hoc against the dev server).
# Existing committed PNGs stay tracked; new throwaway captures are ignored.
.playwright-mcp/alltime-*.png
.playwright-mcp/calendar-*.png
.playwright-mcp/dk-*.png
.playwright-mcp/dk2-*.png
.playwright-mcp/dk3-*.png
.playwright-mcp/lt-*.png
.playwright-mcp/theme-*.png
.playwright-mcp/wide-*.png
.playwright-mcp/check-*.png

# Local xcodebuild DerivedData (orchestrator verification runs)
ios/.ddata/

# Bytecode from the Python release tools (asc-api.py, testflight-notes.py).
ios/Tools/__pycache__/
